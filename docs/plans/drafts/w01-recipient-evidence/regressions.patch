diff --git a/packages/mail/src/smtp-recipients.test.ts b/packages/mail/src/smtp-recipients.test.ts
new file mode 100644
index 00000000..936df715
--- /dev/null
+++ b/packages/mail/src/smtp-recipients.test.ts
@@ -0,0 +1,75 @@
+import { createRequire } from "node:module";
+import nodemailer from "nodemailer";
+import { afterEach, expect, it, vi } from "vitest";
+import { sendViaSmtp } from "./smtp";
+import type { SendPayload } from "./types";
+
+const { SMTPServer } = createRequire(new URL("../../backend/src/imap.int.test.ts", import.meta.url))("smtp-server") as typeof import("../../backend/node_modules/@types/smtp-server");
+const closes: (() => Promise<void>)[] = [];
+afterEach(async () => { vi.restoreAllMocks(); for (const close of closes.splice(0)) await close(); });
+const address = (email: string) => ({ name: "", email });
+const payload: SendPayload = { from: address("sender@example.test"), to: [address("yes@example.test"), address("no@example.test")], cc: [address("later@example.test")], bcc: [address("hidden@example.test")], subject: "Synthetic", text: "One immutable submission", messageId: "recipients@example.test", inReplyTo: null, references: [], providerThreadId: null };
+const entries = [
+  { field: "to", index: 0, address: "yes@example.test", status: "accepted" },
+  { field: "to", index: 1, address: "no@example.test", status: "rejected" },
+  { field: "cc", index: 0, address: "later@example.test", status: "rejected" },
+  { field: "bcc", index: 0, address: "hidden@example.test", status: "accepted" },
+];
+async function fixture(drop = false) {
+  const received: { raw: Buffer; recipients: string[] }[] = [];
+  const server = new SMTPServer({ authOptional: true, disabledCommands: ["STARTTLS"], onAuth: (_a, _s, cb) => cb(null, { user: "synthetic" }),
+    onRcptTo(a, _s, cb) { cb(a.address === "no@example.test" || a.address === "later@example.test" ? Object.assign(new Error("Synthetic rejection"), { responseCode: a.address === "no@example.test" ? 550 : 450 }) : undefined); },
+    onData(stream, session, cb) { const chunks: Buffer[] = []; stream.on("data", (c: Buffer) => chunks.push(c)); stream.on("end", () => { received.push({ raw: Buffer.concat(chunks), recipients: session.envelope.rcptTo.map((r) => r.address) }); if (drop) for (const socket of sockets) socket.destroy(); else cb(); }); },
+  });
+  const sockets = new Set<import("node:net").Socket>();
+  server.server.on("connection", (socket) => { sockets.add(socket); socket.on("close", () => sockets.delete(socket)); });
+  await new Promise<void>((resolve) => server.listen(0, "127.0.0.1", resolve));
+  closes.push(() => new Promise<void>((resolve) => server.close(resolve)));
+  return { received, config: { host: "127.0.0.1", port: (server.server.address() as { port: number }).port, secure: false, user: "synthetic", password: "synthetic", allowInsecure: true } };
+}
+function transformResult(transform: (info: unknown) => unknown) {
+  const create = nodemailer.createTransport.bind(nodemailer);
+  vi.spyOn(nodemailer, "createTransport").mockImplementation((...args: Parameters<typeof nodemailer.createTransport>) => {
+    const transport = create(...args), send = transport.sendMail.bind(transport);
+    transport.sendMail = (async (input: Parameters<typeof send>[0]) => transform(await send(input))) as typeof transport.sendMail;
+    return transport;
+  });
+}
+it("reports exact captured occurrences from real partial SMTP acceptance without claiming delivery", async () => {
+  const t = await fixture();
+  const result = await sendViaSmtp(t.config, payload);
+  expect(t.received).toHaveLength(1); expect(t.received[0]!.recipients).toEqual(["yes@example.test", "hidden@example.test"]);
+  expect(t.received[0]!.raw.equals(result.raw)).toBe(true); expect(result.raw.toString()).not.toMatch(/^Bcc:/mi);
+  expect(result.recipients).toEqual({ version: 1, source: "smtp-response", submission: "accepted", entries });
+});
+it("keeps identical duplicates coherent and case variants unknown", async () => {
+  const t = await fixture();
+  const result = await sendViaSmtp(t.config, { ...payload, to: [address("yes@example.test"), address("yes@example.test"), address("YES@example.test")], cc: [], bcc: [] });
+  expect(result.recipients.entries.map((r) => r.status)).toEqual(["unknown", "unknown", "unknown"]);
+  expect(t.received).toHaveLength(1);
+});
+it.each([
+  { accepted: ["yes@example.test"], rejected: [] },
+  { accepted: ["yes@example.test", "no@example.test", "hidden@example.test"], rejected: ["no@example.test", "later@example.test"] },
+  { accepted: ["outsider@example.test"], rejected: ["no@example.test", "later@example.test"] },
+  { accepted: [], rejected: ["yes@example.test", "no@example.test", "later@example.test", "hidden@example.test"] },
+  { accepted: ["yes@example.test", "hidden@example.test"], rejected: [null] },
+])("treats malformed/inconsistent provider results as unknown: %j", async (report) => {
+  const t = await fixture(); transformResult(() => report);
+  const result = await sendViaSmtp(t.config, payload);
+  expect(t.received).toHaveLength(1);
+  expect(result.recipients).toEqual({ version: 1, source: "smtp-invalid-response", submission: "accepted", entries: entries.map((r) => ({ ...r, status: "unknown" })) });
+  expect(result.recipientOutcomeUnknown).toBe(true); expect(result.rejected).toEqual([]);
+});
+it("accepts provider address objects without retaining foreign diagnostics", async () => {
+  const t = await fixture(); transformResult(() => ({ accepted: ["yes@example.test", "hidden@example.test"], rejected: [{ address: "no@example.test", response: "Untrusted provider text" }, { address: "later@example.test" }] }));
+  const result = await sendViaSmtp(t.config, payload);
+  expect(result.recipients.entries).toEqual(entries);
+});
+
+it("reports all recipients unknown when DATA was received but the final reply is lost", async () => {
+  const t = await fixture(true), recipients = vi.fn();
+  await expect(sendViaSmtp(t.config, payload, { recipients })).rejects.toMatchObject({ ambiguous: true, retryable: false });
+  expect(t.received).toHaveLength(1); expect(t.received[0]!.recipients).toEqual(["yes@example.test", "hidden@example.test"]);
+  expect(recipients).toHaveBeenCalledExactlyOnceWith({ version: 1, source: "smtp-ambiguous", submission: "unknown", entries: entries.map((r) => ({ ...r, status: "unknown" })) });
+});
