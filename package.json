{
  "name": "terno-monorepo",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@12.2.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "postinstall": "node apps/desktop/scripts/ensure-electron.mjs",
    "dev": "pnpm --filter @terno/backend-dev dev & pnpm --filter @terno/web dev",
    "dev:desktop": "pnpm --filter @terno/desktop dev",
    "build": "pnpm --filter @terno/web build && pnpm --filter @terno/desktop build",
    "dist:mac": "pnpm build && pnpm --filter @terno/desktop dist:mac",
    "release:mac": "node apps/desktop/scripts/release.mjs",
    "typecheck": "pnpm -r --parallel typecheck",
    "lint": "oxlint --deny-warnings apps packages",
    "test": "vitest run --project unit && vitest run --project db-wasm",
    "test:watch": "vitest",
    "test:perf": "vitest run --project perf",
    "test:e2e": "pnpm --filter @terno/web test:e2e",
    "test:smoke": "pnpm --filter @terno/desktop test:smoke",
    "dev:desktop:demo": "pnpm --filter @terno/desktop dev:demo",
    "dev:desktop:seeded": "pnpm --filter @terno/desktop dev:seeded",
    "dev:web": "pnpm --filter @terno/web dev:web",
    "build:web": "pnpm --filter @terno/web build:web",
    "test:web": "pnpm --filter @terno/web test:web",
    "test:web-perf": "pnpm --filter @terno/web test:web-perf",
    "test:ui-perf": "pnpm --filter @terno/web test:ui-perf",
    "diag:symbolicate": "node scripts/symbolicate.mjs"
  },
  "devDependencies": {
    "@jridgewell/trace-mapping": "catalog:",
    "@types/jsdom": "^30.0.0",
    "@types/node": "catalog:",
    "jsdom": "30.1.3",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
