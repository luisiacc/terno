{
  "name": "@unica/desktop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "\u00danica: el \u00fanico cliente de email que necesitas",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron dist/main.cjs",
    "dist:mac": "node scripts/package.mjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:seeded": "node scripts/dev.mjs --seeded"
  },
  "dependencies": {
    "@unica/backend": "workspace:*",
    "@unica/mail": "workspace:*",
    "@unica/mcp": "workspace:*",
    "@unica/core": "workspace:*"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@types/node": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:"
  }
}
