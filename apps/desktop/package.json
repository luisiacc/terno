{
  "name": "@terno/desktop",
  "version": "0.1.0",
  "license": "SEE LICENSE IN LICENSE",
  "private": true,
  "type": "module",
  "description": "Terno: your mail, made to measure",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/dev.mjs",
    "start": "env -u ELECTRON_RUN_AS_NODE electron dist/main.cjs",
    "dist:mac": "node scripts/package.mjs",
    "dist:linux": "node scripts/package-linux.mjs",
    "release": "node scripts/release.mjs",
    "release:mac": "node scripts/release.mjs",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:smoke:linux": "playwright test -c playwright.linux.config.ts",
    "test:startup": "playwright test -c playwright.startup.config.ts",
    "typecheck": "tsc -p tsconfig.json",
    "dev:demo": "node scripts/dev.mjs --demo",
    "dev:demo-ai": "node scripts/dev.mjs --demo-ai",
    "dev:seeded": "node scripts/dev.mjs --seeded"
  },
  "dependencies": {
    "@terno/backend": "workspace:*",
    "@terno/core": "workspace:*",
    "@terno/db": "workspace:*",
    "@terno/i18n": "workspace:*",
    "@terno/mail": "workspace:*",
    "@terno/mcp": "workspace:*",
    "electron-updater": "catalog:"
  },
  "devDependencies": {
    "@playwright/test": "catalog:",
    "@terno/mock-data": "workspace:*",
    "@types/node": "catalog:",
    "@types/smtp-server": "^3.5.13",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "esbuild": "catalog:",
    "imapkit": "5.1.0",
    "smtp-server": "^3.21.0"
  }
}
