{
  "name": "@terno/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test:e2e": "playwright test --project=e2e",
    "test:e2e:update": "playwright test --project=e2e --update-snapshots",
    "test:ui-perf": "playwright test --project=perf --no-deps",
    "build:web": "VITE_TARGET=web vite build",
    "dev:web": "VITE_TARGET=web VITE_WEB_DEMO=1 vite build --outDir dist-web-demo && vite preview --outDir dist-web-demo --port ${TERNO_WEB_PORT:-${UNICA_WEB_PORT:-5175}} --strictPort --host 127.0.0.1",
    "test:web": "playwright test -c playwright.web.config.ts --project=web --project=web-conformance",
    "test:web-perf": "playwright test -c playwright.web.config.ts --project=web-perf"
  },
  "dependencies": {
    "@sentry/browser": "catalog:",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-virtual": "^3.14.22",
    "@terno/backend": "workspace:*",
    "@terno/core": "workspace:*",
    "@terno/db": "workspace:*",
    "@terno/idb": "workspace:*",
    "@terno/mail": "workspace:*",
    "@terno/mock-data": "workspace:*",
    "@terno/store": "workspace:*",
    "@terno/ui": "workspace:*",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.61.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fake-indexeddb": "6.2.6",
    "oxc-transform-react": "^0.155.0",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
