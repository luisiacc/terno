{
  "name": "@terno/web",
  "version": "0.1.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.worker.json",
    "test:e2e": "playwright test --project=e2e --project=e2e-lumen --project=e2e-atelier",
    "test:e2e:update": "playwright test --project=e2e --project=e2e-lumen --project=e2e-atelier --update-snapshots",
    "test:ui-perf": "playwright test --project=perf --no-deps",
    "build:web": "VITE_TARGET=web vite build",
    "dev:web": "VITE_TARGET=web VITE_WEB_DEMO=1 vite build --outDir dist-web-demo && vite preview --outDir dist-web-demo --port ${TERNO_WEB_PORT:-${UNICA_WEB_PORT:-5175}} --strictPort --host 127.0.0.1",
    "test:web": "playwright test -c playwright.web.config.ts --project=web --project=web-conformance",
    "test:web-perf": "playwright test -c playwright.web.config.ts --project=web-perf"
  },
  "dependencies": {
    "@sentry/browser": "catalog:",
    "@sqlite.org/sqlite-wasm": "3.54.1-build1",
    "@tanstack/react-virtual": "^3.14.22",
    "@terno/backend": "workspace:*",
    "@terno/core": "workspace:*",
    "@terno/db": "workspace:*",
    "@terno/i18n": "workspace:*",
    "@terno/idb": "workspace:*",
    "@terno/mail": "workspace:*",
    "@terno/mock-data": "workspace:*",
    "@terno/richtext": "workspace:*",
    "@terno/store": "workspace:*",
    "@terno/ui": "workspace:*",
    "cmdk": "^1.1.1",
    "dompurify": "^3.4.16",
    "lucide-react": "^1.61.0",
    "prosemirror-commands": "^1.7.2",
    "prosemirror-history": "^1.5.1",
    "prosemirror-inputrules": "^1.5.1",
    "prosemirror-keymap": "^1.2.3",
    "prosemirror-model": "^1.25.12",
    "prosemirror-schema-list": "^1.5.1",
    "prosemirror-state": "^1.4.4",
    "prosemirror-transform": "^1.12.4",
    "prosemirror-view": "^1.42.8",
    "react": "catalog:",
    "react-dom": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "fake-indexeddb": "6.2.6",
    "oxc-transform-react": "^0.155.0",
    "pdfjs-dist": "6.4.299",
    "tailwindcss": "catalog:",
    "vite": "catalog:"
  }
}
