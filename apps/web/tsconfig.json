{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "types": [
      "vite/client"
    ],
    "paths": {
      "~/*": [
        "./src/*"
      ],
      "@unica/ui/*": [
        "../../packages/ui/src/*"
      ]
    }
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/web/worker"
  ]
}
